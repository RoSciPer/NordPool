# Telegram bot
TELEGRAM_BOT_TOKEN=replace-me

# Public base URL of the FastAPI server (no trailing slash).
# Shelly devices need to reach this over HTTPS from the internet.
SERVER_BASE_URL=https://lvprices.bidsolana.bid

# Optional: where SQLite DB lives (defaults to ./prices.db)
# NORDPOOL_DB=/opt/projects/NordPool/prices.db

# Optional: how often the FastAPI background refresher tries to pull prices
# REFRESH_INTERVAL_SEC=1800

# Optional: uvicorn binding (used by nordpool_server.service)
# HOST=0.0.0.0
# PORT=8080
# LOG_LEVEL=INFO
