[Unit]
Description=NordPool Shelly Schedule API (FastAPI / uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/projects/NordPool
EnvironmentFile=/opt/projects/NordPool/.env
ExecStart=/opt/projects/NordPool/venv/bin/uvicorn server:app \
    --host 0.0.0.0 --port 8081 --proxy-headers --forwarded-allow-ips=*
Restart=always
RestartSec=5
StandardOutput=append:/opt/projects/NordPool/server.log
StandardError=append:/opt/projects/NordPool/server.log

# Security hardening (keep /opt/projects writable for SQLite)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
